# Copy to .env.pilot-m5-5, replace every placeholder, and chmod 600.
# Never commit the populated file or upload it to a cloud service.

PILOT_M5_5_BASE_URL=http://127.0.0.1
PILOT_M5_5_ORGANISATION_CODE=REPLACE_ME
PILOT_M5_5_INSTITUTION_NAME=REPLACE_ME
PILOT_M5_5_RELEASE_VERSION=1.0.0

# Use the activated, non-demo Organisation Admin for the approved tenant.
PILOT_M5_5_ADMIN_EMAIL=REPLACE_ME
PILOT_M5_5_ADMIN_PASSWORD=REPLACE_ME

# GO, CONDITIONAL_RETEST, or NO_GO. GO is rejected unless every mandatory row
# passes. Conditional Retest also requires a future UTC deadline.
PILOT_M5_5_OUTCOME=REPLACE_ME
PILOT_M5_5_DECISION_REASON=REPLACE_ME
PILOT_M5_5_RETEST_BY_UTC=

# The passed/failed LIVE M5.4 reconciliation, current verified local backup,
# signed institution record, and owned S3/S4 issue register.
PILOT_M5_5_LIVE_RECONCILIATION=REPLACE_WITH_LIVE_RECONCILIATION_JSON
PILOT_M5_5_BACKUP_DIRECTORY=REPLACE_WITH_LATEST_VERIFIED_BACKUP_DIRECTORY
PILOT_M5_5_SIGNED_ACCEPTANCE_FILE=REPLACE_WITH_SIGNED_ACCEPTANCE_PDF
PILOT_M5_5_INCIDENT_FILE=.pilot-m5-4-incidents.csv
PILOT_M5_5_KNOWN_ISSUES_FILE=.pilot-m5-5-known-issues.csv

# Named human acceptance and operating owners.
PILOT_M5_5_AUTHORISED_BY=REPLACE_ME
PILOT_M5_5_AUTHORISER_TITLE=REPLACE_ME
PILOT_M5_5_UAT_LEAD=REPLACE_ME
PILOT_M5_5_TECHNICAL_OWNER=REPLACE_ME
PILOT_M5_5_SUPPORT_CONTACT=REPLACE_ME
PILOT_M5_5_MONITORING_OWNER=REPLACE_ME
PILOT_M5_5_BACKUP_RESTORE_OWNER=REPLACE_ME
PILOT_M5_5_INCIDENT_OWNER=REPLACE_ME
PILOT_M5_5_ROLLBACK_OWNER=REPLACE_ME
PILOT_M5_5_DATA_PRIVACY_OWNER=REPLACE_ME
PILOT_M5_5_HANDOVER_RECIPIENT=REPLACE_ME

# Use human-readable labels; do not expose credentials in these values.
PILOT_M5_5_PRIMARY_DATA_MEDIA=REPLACE_ME
PILOT_M5_5_BACKUP_MEDIA=REPLACE_ME

# These exact confirmations protect Rabbit's binding local-only architecture.
PILOT_M5_5_LOCAL_DATA_CONFIRMED=yes
PILOT_M5_5_LOCAL_ONLY_CONFIRMED=yes
PILOT_M5_5_OWNERSHIP_ACCEPTED=REPLACE_WITH_yes_OR_no
PILOT_M5_5_SCOPE_FREEZE_ACCEPTED=REPLACE_WITH_yes_OR_no
