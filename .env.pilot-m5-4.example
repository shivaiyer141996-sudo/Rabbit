# Copy to .env.pilot-m5-4, replace every placeholder, and chmod 600.
# Never commit the populated file or attach it to an evidence bundle.

# Run REHEARSAL first. After its evidence is accepted, create a new freeze using
# LIVE and the separately scheduled live assessment ID.
PILOT_M5_4_EVENT_TYPE=REHEARSAL
PILOT_M5_4_BASE_URL=http://127.0.0.1
PILOT_M5_4_ORGANISATION_CODE=REPLACE_ME
PILOT_M5_4_INSTITUTION_NAME=REPLACE_ME
PILOT_M5_4_RELEASE_VERSION=REPLACE_WITH_RABBIT_RELEASE_VERSION_FROM_ENV
PILOT_M5_4_ASSESSMENT_ID=REPLACE_ME

# Use the activated, non-demo Organisation Admin for the approved tenant.
PILOT_M5_4_ADMIN_EMAIL=REPLACE_ME
PILOT_M5_4_ADMIN_PASSWORD=REPLACE_ME

# These local files contain institution data and must remain mode 600/400 and
# ignored by Git. Use the committed templates under infra/pilot/templates/.
PILOT_M5_4_ROSTER_FILE=.pilot-m5-4-roster.csv
PILOT_M5_4_INCIDENT_FILE=.pilot-m5-4-incidents.csv

# Use the latest checksum-verified, quiesced backup on the approved separate
# local device. Freeze requires this backup to be no older than 24 hours and to
# match the clean release commit.
PILOT_M5_4_BACKUP_DIRECTORY=REPLACE_WITH_LATEST_VERIFIED_BACKUP_DIRECTORY

# Release 1.0 pilot baseline. Change only when the institution approves a
# different bounded rehearsal; live execution remains 30-45 questions/45-60 min.
PILOT_M5_4_MIN_QUESTIONS=30
PILOT_M5_4_MAX_QUESTIONS=45
PILOT_M5_4_MIN_DURATION_MINUTES=45
PILOT_M5_4_MAX_DURATION_MINUTES=60
PILOT_M5_4_MAX_STUDENTS=30

# Named human owners. Names are recorded in the restricted local freeze bundle;
# passwords and Student emails are never copied into ordinary JSON evidence.
PILOT_M5_4_UAT_LEAD=REPLACE_ME
PILOT_M5_4_TECHNICAL_OWNER=REPLACE_ME
PILOT_M5_4_SUPPORT_OWNER=REPLACE_ME
PILOT_M5_4_ROLLBACK_OWNER=REPLACE_ME
PILOT_M5_4_DATA_PRIVACY_OWNER=REPLACE_ME
PILOT_M5_4_INCIDENT_CHANNEL=REPLACE_ME
