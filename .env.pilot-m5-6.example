# Copy to .env.pilot-m5-6, replace every placeholder, and chmod 600.
# Never commit the populated file or place it on cloud storage.

PILOT_M5_6_BASE_URL=http://127.0.0.1
PILOT_M5_6_ORGANISATION_CODE=REPLACE_ME

# Use the same activated, non-demo Organisation Admin and tenant used for M5.5.
PILOT_M5_6_ADMIN_EMAIL=REPLACE_ME
PILOT_M5_6_ADMIN_PASSWORD=REPLACE_ME

# Both paths must point to passed, checksummed M5.5 bundles for the same Go
# decision and exact release commit.
PILOT_M5_6_M5_5_PREPARED_MANIFEST=REPLACE_WITH_M5_5_PREPARE_MANIFEST_JSON
PILOT_M5_6_M5_5_FINAL_MANIFEST=REPLACE_WITH_M5_5_FINAL_MANIFEST_JSON

PILOT_M5_6_RELEASE_VERSION=1.0.0
PILOT_M5_6_RELEASE_TAG=v1.0.0
PILOT_M5_6_MAIN_REF=origin/main

# Use a directory on an approved separate local disk/USB device. The generated
# bundle contains source and runtime images, but no database, credentials, or
# signed institution PDF.
PILOT_M5_6_RELEASE_OUTPUT=REPLACE_WITH_SEPARATE_LOCAL_RELEASE_DIRECTORY
PILOT_M5_6_RELEASE_MEDIA=REPLACE_ME

# Named people who will perform and independently verify the fast-forward/tag.
PILOT_M5_6_RELEASE_OWNER=REPLACE_ME
PILOT_M5_6_VERIFICATION_OWNER=REPLACE_ME

# The complete seven-image archive makes Release 1.0 reinstallable without a
# registry. Keep this enabled for formal M5.6 acceptance.
PILOT_M5_6_EXPORT_RUNTIME_IMAGES=yes
PILOT_M5_6_LOCAL_ONLY_CONFIRMED=yes
