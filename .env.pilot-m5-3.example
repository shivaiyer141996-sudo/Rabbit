# Copy to .env.pilot-m5-3, replace every placeholder, and chmod 600.
# This protected local file is mounted read-only into one-off evidence containers.
# Never commit the populated copy or attach it to pilot evidence.

# Approved live-student target. M5.3 automatically tests this count plus 50%.
PILOT_APPROVED_CONCURRENT_STUDENTS=30
PILOT_LOAD_DURATION=5m

# Use an active, non-demo Student with one organisation membership. The account
# must have at least one published rehearsal result for functional recovery proof.
RABBIT_LOAD_STUDENT_EMAIL=REPLACE_ME
RABBIT_LOAD_STUDENT_PASSWORD=REPLACE_ME

# Use an active, non-demo Organisation Admin in the same organisation.
RABBIT_RECOVERY_ADMIN_EMAIL=REPLACE_ME
RABBIT_RECOVERY_ADMIN_PASSWORD=REPLACE_ME
RABBIT_RECOVERY_STUDENT_EMAIL=REPLACE_ME
RABBIT_RECOVERY_STUDENT_PASSWORD=REPLACE_ME
RABBIT_RECOVERY_ORGANISATION_CODE=REPLACE_ME

# Human-owned security and rollback evidence. These values are recorded in the
# redacted evidence manifest; credentials above are never recorded.
PILOT_SECURITY_REVIEWER=REPLACE_ME
PILOT_ROLLBACK_TESTER=REPLACE_ME
PILOT_INCIDENT_CHANNEL=REPLACE_ME
PILOT_ROLLBACK_RELEASE_VERSION=REPLACE_WITH_VERIFIED_LOCAL_IMAGE_TAG
PILOT_ROLLBACK_REHEARSAL_CONFIRMED=no
