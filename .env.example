# Local-only defaults. Replace every credential outside local development.
POSTGRES_DB=rabbit
POSTGRES_USER=rabbit
POSTGRES_PASSWORD=rabbit_local_password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

MINIO_ROOT_USER=rabbit
MINIO_ROOT_PASSWORD=rabbit_local_minio_password
MINIO_BUCKET=question-assets

RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit_local_queue_password

NEXT_PUBLIC_API_BASE_URL=/gateway/backend
BACKEND_INTERNAL_URL=http://backend:8080/api/v1
