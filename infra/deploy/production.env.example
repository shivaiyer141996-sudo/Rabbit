# Dormant local Release 1.0 image-mode example. This file does not approve a
# public endpoint, cloud registry, or production-scale deployment. Copy it to a
# protected local environment only after M5.6 Go closure; never commit values.
POSTGRES_DB=rabbit
POSTGRES_USER=rabbit_runtime
POSTGRES_PASSWORD=replace-with-a-unique-strong-secret

JWT_SECRET=replace-with-at-least-48-random-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=PT30M
INVITATION_TTL=PT72H
INVITATION_ACTIVATION_BASE_URL=http://127.0.0.1/activate

MINIO_ROOT_USER=rabbit_assets
MINIO_ROOT_PASSWORD=replace-with-a-unique-strong-secret
MINIO_BUCKET=question-assets

RABBITMQ_DEFAULT_USER=rabbit_events
RABBITMQ_DEFAULT_PASS=replace-with-a-unique-strong-secret

NEXT_PUBLIC_API_BASE_URL=/gateway/backend
BACKEND_INTERNAL_URL=http://backend:8080/api/v1
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
RABBIT_RELEASE_VERSION=1.0.0
RABBIT_RELEASE_COMMIT=replace-with-the-approved-40-character-commit
RABBIT_ENVIRONMENT=release-local
COMMERCIAL_CONTROLS_ENABLED=false
COMMERCIAL_M5_6_EVIDENCE_REFERENCE=
SPRING_PROFILES_ACTIVE=docker
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300

RABBIT_API_IMAGE=rabbit-aip-api:1.0.0
RABBIT_WEB_IMAGE=rabbit-aip-web:1.0.0
