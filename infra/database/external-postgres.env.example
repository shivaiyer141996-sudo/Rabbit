# FUTURE USE ONLY. Milestone 5 continues to use the bundled local PostgreSQL.
# Copy to external-postgres.env only after a separately approved migration.

DATABASE_URL=jdbc:postgresql://replace-target-host:5432/rabbit?sslmode=require
DATABASE_USERNAME=rabbit_runtime
DATABASE_PASSWORD=replace-with-the-target-database-secret

# Begin conservatively for a shared or managed target and tune from evidence.
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=2
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_VALIDATION_TIMEOUT_MS=3000
DATABASE_MAX_LIFETIME_MS=1800000

# PostgreSQL is the supported Release 1.0 engine. A different engine must use a
# separately reviewed migration location and include its JDBC/Flyway support.
DATABASE_MIGRATION_LOCATIONS=classpath:db/migration
