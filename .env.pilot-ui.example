# Copy to .env.pilot-ui, restrict the file to the designated tester, and replace
# every placeholder. These accounts must belong to the same approved pilot tenant.
PILOT_UI_BASE_URL=http://127.0.0.1
PILOT_UI_EXPECTED_ORG_CODE=REPLACE_ME
PILOT_UI_TESTER_NAME=REPLACE_ME

PILOT_UI_ADMIN_EMAIL=REPLACE_ME
PILOT_UI_ADMIN_PASSWORD=REPLACE_ME

PILOT_UI_ACADEMIC_HEAD_EMAIL=REPLACE_ME
PILOT_UI_ACADEMIC_HEAD_PASSWORD=REPLACE_ME

PILOT_UI_TEACHER_EMAIL=REPLACE_ME
PILOT_UI_TEACHER_PASSWORD=REPLACE_ME

PILOT_UI_REVIEWER_EMAIL=REPLACE_ME
PILOT_UI_REVIEWER_PASSWORD=REPLACE_ME

PILOT_UI_STUDENT_EMAIL=REPLACE_ME
PILOT_UI_STUDENT_PASSWORD=REPLACE_ME
